# MODEL FLAGS BIT FORMAT:
# The default model flags are 3 (MODEL_FLAGS_UV_ROUND | MODEL_FLAGS_GOURAUD)
#MODEL_FLAGS_UV_ROUND = 1,
# If set, UV coordinate rounding will be used in the texture mapper.
# (SET by default unless you encounter texturing issues with certain objects.)
#MODEL_FLAGS_GOURAUD = 2,
# If set, gouraud (smooth) shading will be enabled for this model.
#MODEL_FLAGS_DIRECTIONAL_ONLY = 4,
# If set, only directional (planar) light types will be applied to this model.
# IMPORTANT:  Always use directional lighing with the city model/partition!
#MODEL_FLAGS_NO_ALTERNATE_RENDERING = 8,
# MD2 files: If set, the renderer will not use the subdividing triangle rasterizer
# when the model is further away (looks better, but is usually slower.)
#MODEL_FLAGS_FLIP_VNORMALS = 16,
# MD2 files: If set, the vertex normals included in the file will be flipped.
# Some models have normals which don't face the right direction.
#MODEL_FLAGS_USE_ALPHA_BLENDING = 32,
# If true, alpha blending will be used to draw any faces which
# use transparent textures (verses alpha testing).
# All models which use this flag should be drawn in back to front order
# relative to the camera!
# MODEL_FLAGS_DO_NOT_BACKFACE_CULL = 64,
# If set, backface culling will not be used when rendering this object.
# NOTE: The software rendering driver currently ignores this flag.
# MODEL_FLAGS_PERSPECTIVE_CORRECT = 128,
# MESH models: If set, the model will be rasterized using a perspective
# correct texture mapper. Is slower, use only when needed.
# MODEL_FLAGS_DRAW_SHADOW = 256,
# MODEL_FLAGS_DRAW_SHADOW_DYNAMIC = 512,

*GLB GlobalSettings ThisIsDescriptionOnly=1 
	UpgradeCop = 0 UpgradeFire = 0 UpgradeAmbul = 0
	AmbientVolumeScale = 0.5 EngineVolumeScale = 0.45 MusicVolumeScale = 1.0
	PlainVolumeScale = 0.3

# ----------------------------------------------------------------
#         This is a Matchbox Game Shapes decription file
# ----------------------------------------------------------------
*NNN sky	model_flags=4 depth_mode=2

